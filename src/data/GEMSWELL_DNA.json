  "typography": {
    "direction": "modern geometric sans-serif",
    "recommended_style": {
      "headings": {
        "type": "bold sans-serif",
        "weight": "700-900",
        "case": "sentence case or uppercase for short impact statements",
        "tracking": "slightly tight",
        "feel": "confident, contemporary, sporty"
      },
      "body": {
        "type": "clean sans-serif",
        "weight": "400-500",
        "line_height": "1.45-1.65",
        "feel": "clear, accessible, lifestyle editorial"
      },
      "numbers_and_stats": {
        "type": "large bold sans-serif",
        "weight": "800-900",
        "style": "oversized metrics, minimal text, high contrast"
      },
      "ctas": {
        "type": "bold sans-serif",
        "weight": "600-800",
        "case": "short sentence case",
        "style": "compact, direct, action-led"
      }
    },
    "font_suggestions": {
      "premium_option": ["Suisse Int'l", "Neue Haas Grotesk", "Avenir Next"],
      "google_fonts_alternatives": ["Inter", "Manrope", "Sora", "Plus Jakarta Sans"],
      "fallback_stack": "Inter, Manrope, Helvetica Neue, Arial, sans-serif"
    }
  },
  "layout": {
    "overall_structure": "immersive landing page with large hero, image-led sections, numbered reason blocks, metric cards and conversion-focused waitlist CTA",
    "grid": {
      "desktop": "12-column flexible grid",
      "tablet": "6-column grid",
      "mobile": "single-column stacked layout"
    },
    "spacing": {
      "style": "generous vertical spacing",
      "section_padding_desktop": "96px-160px",
      "section_padding_mobile": "56px-88px",
      "card_gap": "24px-40px"
    },
    "composition_principles": [
      "Use full-width immersive image or video hero areas.",
      "Alternate calm editorial sections with high-energy visual blocks.",
      "Use large numbers for credibility and scale.",
      "Keep text blocks short and easy to scan.",
      "Use cards for activities, ambassadors, features and construction updates.",
      "Let photography/video carry emotional weight."
    ]
  },
